{
  "name": "sound-atlas",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "description": "Sound Atlas 鈥?a global environmental sound map. Explore real field recordings on a world map, listen in ambient mode, build your own sound maps and journeys.",
  "license": "MIT",
  "author": {
    "name": "0xkillcoin",
    "url": "https://x.com/0xkillcoin"
  },
  "homepage": "https://iiiiiiiiiiiiiikk.github.io/sound-atlas/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiiiiiiiiiiiiKK/sound-atlas.git"
  },
  "keywords": [
    "sound-map",
    "field-recording",
    "ambient",
    "environmental-sound",
    "inaturalist",
    "wikimedia-commons",
    "leaflet",
    "react",
    "typescript",
    "local-first"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4319 --strictPort",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "catalog": "node scripts/fetch-commons-catalog.mjs",
    "shots": "node scripts/screenshots.mjs",
    "verify:prod": "node scripts/verify-production.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}

